# Sponsor integration mode: "mock" (default, fully offline) or "live".
# In live mode, any adapter with missing keys still falls back to its mock.
SPONSOR_MODE=mock

# Model adapter. Provider "mock" returns deterministic fixtures.
MODEL_PROVIDER=mock
MODEL_API_KEY=

# Actian classroom record store.
ACTIAN_URL=
ACTIAN_API_KEY=

# Guild control plane (agent registry, approvals, audit).
GUILD_API_KEY=

# Band agent communication mesh.
BAND_API_KEY=

# Replay demo-reliability recorder.
REPLAY_API_KEY=
