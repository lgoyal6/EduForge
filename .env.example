# Sponsor integration mode: "mock" (default, fully offline) or "live".
# In live mode, any adapter with missing keys still falls back to its mock.
SPONSOR_MODE=mock

# Model adapter. Provider "mock" returns deterministic fixtures.
MODEL_PROVIDER=mock
MODEL_API_KEY=

# Actian classroom record store.
ACTIAN_URL=
ACTIAN_API_KEY=

# Guild control plane (agent registry, approvals, audit).
GUILD_API_KEY=

# Band agent communication mesh (band.ai). Live mode needs BOTH the API key
# and the agent id from a Remote Agent created at https://app.band.ai/agents.
# URLs default to Band's hosted platform; override only for self-hosted/VPC.
BAND_API_KEY=
BAND_AGENT_ID=
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Replay demo-reliability recorder.
REPLAY_API_KEY=
